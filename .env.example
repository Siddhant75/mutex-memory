# CockroachDB Cloud connection. Use a dedicated development database.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full
TEST_DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# Required only for live Bedrock/Titan calls.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=YOUR_BEDROCK_MODEL_OR_INFERENCE_PROFILE_ID
